# MEDHA frontend configuration (Next.js only — never commit real values).
# Copy this file to `frontend/.env.local` for split local development.
# Next.js reads ONLY this directory's env files; the repository-root `.env`
# is invisible to `next dev` / `next build`. Backend variables stay in the
# root `.env` (see root .env.example).
#
# Public vs secret: NEXT_PUBLIC_* values are inlined into the client bundle at
# build time — only identifiers meant to be public go there. MEDHA_API_TOKEN
# and CLERK_SECRET_KEY are read exclusively by server-side code
# (src/middleware.ts) and never enter the bundle.

# Backend origin override for split local development (optional). Empty/unset
# means same-origin: the browser calls /api/* on the Next.js origin and the
# next.config.js rewrites proxy them to the FastAPI backend (127.0.0.1:8000).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Shared secret for mutating API routes (server-side only). Optional locally;
# must match the backend's MEDHA_API_TOKEN when token auth is enabled.
# MEDHA_API_TOKEN=

# Clerk authentication (required only when MEDHA_AUTH_MODE=clerk on the backend).
# Publishable key: public identifier, safe for the client bundle.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key: server-side only, used by middleware to detect Clerk configuration.
# CLERK_SECRET_KEY=

# Optional Clerk redirect customization (Clerk framework convention; only
# needed to override Clerk's default sign-in routing for the /sign-in and
# /sign-up routes).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MEDHA Environment Configuration
# Copy to `.env` for local overrides. Do not commit `.env`.

# Application
MEDHA_ENV=development
MEDHA_DEBUG=true
MEDHA_HOST=127.0.0.1
MEDHA_PORT=8000
MEDHA_CORS_ORIGINS=http://localhost:3000

# SQLite
MEDHA_DATABASE_PATH=./data/medha.db

# Workflow pacing (SSE demo readability)
MEDHA_WORKFLOW_STEP_DELAY_SECONDS=0.35

# Execution (opt-in local Docker mutate; default uses SimulatorExecutor)
MEDHA_DOCKER_EXECUTE=false
MEDHA_DOCKER_CLEANUP=true
MEDHA_MAX_VERIFY_ROUNDS=3
MEDHA_EXECUTOR_MODE=auto
# auto | simulator | docker

# Logging
MEDHA_LOG_LEVEL=INFO

# Frontend (public — no secrets)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_MODE_DEFAULT=true

# Optional LLM mediation (unused by default; core paths work without keys)
# MEDHA_LLM_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

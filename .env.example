# MEDHA Environment Configuration (backend + single-service supervisor).
# Copy this file to `.env` for local development. Never commit `.env`.
#
# Ownership: this file configures the FastAPI backend (read by backend/app/core/config.py
# via backend/.env then root .env; shell env wins over both) and the single-service
# supervisor (scripts/run_service.py: MEDHA_BACKEND_HOST/PORT). Frontend (Next.js) variables
# live in frontend/.env.example and are configured locally via frontend/.env.local —
# Next.js never reads this root file, so NEXT_PUBLIC_* / CLERK_SECRET_KEY entries here
# would have no effect on `next dev`. Keep backend secrets exclusively here.

# Application
MEDHA_ENV=development
MEDHA_DEBUG=true
MEDHA_HOST=127.0.0.1
MEDHA_PORT=8000
MEDHA_CORS_ORIGINS=http://localhost:3000

# Single-service supervisor (scripts/run_service.py + Dockerfile). These select where
# the loopback backend listens inside the supervised topology; they must stay on
# port 8000 to match the fixed Next.js rewrite destination (frontend/next.config.js).
MEDHA_BACKEND_HOST=127.0.0.1
MEDHA_BACKEND_PORT=8000

# SQLite (default backend; used for all local development unless Postgres
# is explicitly selected below). Zero-config: leave MEDHA_DATABASE_URL
# commented out and the backend starts instantly on this file, no network.
MEDHA_DATABASE_PATH=./data/medha.db

# Backend selector: "" (default) = SQLite locally, Postgres on Render
# (MEDHA_ENV=production). Set "postgres" ONLY for intentional local
# Postgres development against a reachable server; a production URL sitting
# in a local .env without this flag is ignored with a startup warning, so
# a stray pooler URL can never hang local startup. "sqlite" pins SQLite.
# MEDHA_DATABASE_BACKEND=

# Main backend database (Supabase Postgres, ADR-029).
# LOCAL: keep commented (SQLite default above). Uncomment + set
# MEDHA_DATABASE_BACKEND=postgres only to develop against Postgres locally.
# RENDER (dashboard, secret — never commit): MEDHA_ENV=production always
# uses this URL; missing/invalid refuses to boot (fail-closed, no SQLite).
# Use the pooled connection (port 6543) for hosted use; direct 5432 is fine
# for local development.
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:6543/postgres
# (pooled 6543 for hosted use; direct 5432 is fine for local development).
# MEDHA_DATABASE_URL=

# Workflow pacing (SSE readability; 0 disables the presentation pause)
MEDHA_WORKFLOW_STEP_DELAY_SECONDS=0.35

# Execution (genuine deployment only; never simulated success)
# MEDHA_EXECUTOR_MODE=simulator selects the explicit test-only simulator
# (results are labelled test-only and can never be healthy). Any other mode
# without an isolated Docker builder fails closed (EXECUTION_NOT_CONFIGURED).
# Use MEDHA_EXECUTOR_MODE=disabled on hosts where no execution is wanted.
MEDHA_DOCKER_EXECUTE=false
MEDHA_DOCKER_CLEANUP=true
MEDHA_MAX_VERIFY_ROUNDS=3
MEDHA_EXECUTOR_MODE=auto
# Bounded waits for in-process pipeline stages (seconds, clamped to 1..3600).
# A timeout fails the run closed (TIMEOUT:*); detached worker threads cannot
# be killed, so their late results are dropped instead of accepted.
MEDHA_TIMEOUT_ANALYZE_S=120
MEDHA_TIMEOUT_SPECIALISTS_S=30
MEDHA_TIMEOUT_VERIFY_S=30
# Network-facing repository acquisition (clone/fetch) bound. Same fail-closed
# wait-not-kill semantics as the other stage timeouts.
MEDHA_TIMEOUT_ACQUIRE_S=120
# Demo engine: removed from the product. backend/app/demo/* fixtures exist
# for isolated automated tests only and are unreachable from product routes.
MEDHA_ENABLE_DEMO=false
# auto | simulator | docker | real | disabled. "real"/"docker" take effect only together
# with MEDHA_DOCKER_EXECUTE=true on a non-production host with a reachable
# Docker daemon; the hosted control plane (MEDHA_ENV=production) rejects them
# and stays simulator-only. See docs/REAL_EXECUTION_RUNBOOK.md.

# --- Isolated real-execution builder/runtime ---
# Seconds allowed for `docker build` of the generated (MEDHA-authored, never
# repo-authored) Dockerfile. Must be > 0 when real execution is requested.
MEDHA_REAL_BUILD_TIMEOUT_SECONDS=600
# Seconds allowed for the started container to pass its HTTP readiness gate
# (loopback probe of the profile health endpoint). Must be > 0 when real
# execution is requested; the deployment fails closed on timeout.
MEDHA_REAL_READINESS_TIMEOUT_SECONDS=90

# Logging
MEDHA_LOG_LEVEL=INFO

# Shared secret for mutating API routes (X-Medha-Token). Optional locally;
# required in production (render.yaml generates it; backend fails closed
# without it). For split local development (`next dev`), set the SAME value in
# frontend/.env.local so the Next.js middleware can inject it server-side.
# Never put it in NEXT_PUBLIC_* or the client bundle.
# MEDHA_API_TOKEN=

# --- AI provider integration (Groq primary, Gemini fallback) ---
# Disabled by default: the deterministic pipeline always works without keys.
# All AI output is advisory, schema-validated, and recorded per run; the
# pipeline continues deterministically when providers are unavailable.
MEDHA_AI_ENABLED=false
MEDHA_AI_PRIMARY_PROVIDER=groq
MEDHA_AI_FALLBACK_PROVIDER=gemini
# Defaults verified against provider docs (Oct 2026): Groq "openai/gpt-oss-20b"
# (fast production model; "openai/gpt-oss-120b" for stronger reasoning),
# Gemini "gemini-3.8-flash" (current generation; 2.5-flash is legacy-only).
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MEDHA_AI_REQUEST_TIMEOUT_SECONDS=20
MEDHA_AI_MAX_RETRIES=1
MEDHA_AI_MAX_OUTPUT_TOKENS=1200
MEDHA_AI_MAX_CALLS_PER_RUN=6

# --- Clerk authentication (backend verification) ---
# "off" (default): legacy single-operator behavior, no Bearer required.
# "clerk": FastAPI verifies Clerk session JWTs (signature/issuer/expiry) and
# scopes runs/proposals to the verified user. Never expose secrets to the
# browser; NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY belong in
# frontend/.env.local (see frontend/.env.example).
MEDHA_AUTH_MODE=off
# Your Clerk frontend API domain, e.g. abc-123.clerk.accounts.dev
# CLERK_DOMAIN=
# Or an explicit JWKS URL (defaults to https://<CLERK_DOMAIN>/.well-known/jwks.json)
# CLERK_JWKS_URL=

# --- GitHub webhook (push-triggered approval proposals) ---
# Server-only secret; must match the webhook secret configured on GitHub.
# When unset, POST /api/webhooks/github fails closed (503).
# GITHUB_WEBHOOK_SECRET=
# Server-level guard only. Primary routing is per-owner project connections
# (POST /api/projects or the "Connect GitHub repo" UI): once any project
# exists, pushes for unmapped/disconnected repos are ignored. The allowlist
# below remains as defense-in-depth. Empty accepts any repo in development
# but fails closed in production.
MEDHA_WEBHOOK_ALLOWED_REPOS=
# Comma-separated watched branches (pushes to other branches are ignored).
MEDHA_WEBHOOK_BRANCHES=main

# --- GitHub App (private-repo support; server-only, never commit values) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# --- Abuse protection ---
MEDHA_RATE_LIMIT_PER_MINUTE=60
# IP of a directly-connected trusted reverse proxy (empty = trust none).
# X-Forwarded-For is honored ONLY when the direct peer matches this value;
# spoofed forwarding headers from anyone else are ignored for rate limiting.
# Leave empty unless the backend sits behind a correctly configured proxy.
# MEDHA_TRUSTED_PROXY=

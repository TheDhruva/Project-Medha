# Keep the deploy image free of local history, caches, and runtime state.
.git
**/.git/
backend/.venv/
backend/**/__pycache__/
backend/data/
data/*.db
frontend/node_modules/
frontend/.next/
frontend/build-output*.txt
frontend/lint-output*.txt
frontend/eslint-errors.txt
frontend/test-output*.txt
frontend/test-summary.txt
frontend/vitest-*.txt
node_modules/
__pycache__/
*.db
*.sqlite
*.sqlite3
.pytest_cache/
.env
.env.*
*.pem
*.key
